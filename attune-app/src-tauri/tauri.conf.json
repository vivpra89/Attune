{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Attune",
  "version": "0.1.0",
  "identifier": "ai.attune.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Attune",
        "width": 320,
        "height": 48,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "visible": false,
        "center": false,
        "contentProtected": true,
        "focus": false,
        "acceptFirstMouse": true,
        "shadow": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "info.plist",
      "models/AttuneEngagement.mlmodelc",
      "models/AttuneAffect.mlmodelc",
      "models/AttuneGazeAway.mlmodelc",
      "resources/sounds/nudge.wav",
      "resources/sounds/dim.wav",
      "resources/sounds/reengage.wav"
    ],
    "macOS": { "minimumSystemVersion": "12.0" }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:attune.db"]
    }
  }
}

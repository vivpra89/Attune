{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Attune main capabilities",
  "windows": ["main", "parent-dashboard", "attention-dim-*", "debug-overlay"],
  "platforms": ["macOS"],
  "permissions": [
    "core:default",
    "core:tray:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "opener:default",
    "keychain:default",
    "keychain:allow-get-item",
    "keychain:allow-save-item",
    "keychain:allow-remove-item",
    "macos-permissions:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}

{
  "name": "attune",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time attention layer for children's learning — dim when disengaged, clear when focused.",
  "author": {
    "name": "Attune",
    "email": "hello@attune.ai"
  },
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "generate:models": "bash ../scripts/bootstrap_inference.sh",
    "convert:affect": "python ../ml/convert_hsemotion_affect.py && python ../ml/verify_models.py",
    "tauri": "tauri",
    "prepare:mas": "bash scripts/prepare-mas-entitlements.sh",
    "build:mas": "bash scripts/prepare-mas-entitlements.sh && npm run tauri build -- --config src-tauri/tauri.mas.conf.json --bundles app --target universal-apple-darwin -- --no-default-features --features app-store",
    "build:mas:aarch64": "bash scripts/prepare-mas-entitlements.sh && npm run tauri build -- --config src-tauri/tauri.mas.conf.json --bundles app --target aarch64-apple-darwin -- --no-default-features --features app-store"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.1.12",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-sql": "^2.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.539.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-error-boundary": "^6.0.0",
    "react-router-dom": "^7.9.5",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12",
    "tauri-plugin-keychain": "^2.0.1",
    "tauri-plugin-macos-permissions-api": "^2.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tw-animate-css": "^1.3.6",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
